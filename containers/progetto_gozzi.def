Bootstrap: docker
From: python:3.12.13-slim

%labels
    Author Luca Galli
    Description Progetto Gozzi pipeline — community detection and flexibility analysis

%files
    requirements.txt /opt/requirements.txt

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
    && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir -r /opt/requirements.txt

%environment
    export LC_ALL=C
    export PYTHONUNBUFFERED=1

%runscript
    set -euo pipefail
    echo "Step 1/4: making windows"
    python scripts/02_make_windows.py
    echo
    echo "Step 2/4: computing window connectivity"
    python scripts/03_compute_window_connectivity.py
    echo
    echo "Step 3/4: running temporal Leiden community detection"
    python scripts/04_run_community_detection.py
    echo
    echo "Step 4/4: aggregating flexibility scores"
    python scripts/05_compute_flexibilty.py
    echo
    echo "Pipeline complete."

%startscript
    # Keep a named instance alive while commands run through instance://.
    exec sleep infinity

%help
    Apptainer container for the Progetto Gozzi pipeline.

    Build:
        ./container_pipeline.sh build

    From inside the containers directory:
        ../container_pipeline.sh build

    Run the full pipeline:
        ./container_pipeline.sh run

    Run as a named instance with reliable whole-job shutdown:
        ./container_pipeline.sh run
        ./container_pipeline.sh stop

    Run an arbitrary command (e.g. a single script):
        apptainer exec containers/progetto_gozzi.sif python scripts/04_run_community_detection.py

    Open an interactive shell:
        apptainer shell containers/progetto_gozzi.sif

    Apptainer automatically bind-mounts your current working directory, so
    run all commands from the project root and the scripts will find data files
    at the paths they expect.  No --bind flag needed in the common case.
